# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Alpaca (required) ---------------------------------------------------- #
# Paper trading keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# --- Risk officer LLM ------------------------------------------------------ #
# Featherless is the primary provider; a local Ollama model is the automatic
# fallback, so the agent still runs (more conservatively) without a key.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Scan universe + cadence ----------------------------------------------- #
AGENT_UNIVERSE=SPY,QQQ,IWM,DIA,GLD,SLV,TLT,XLF,XLE,XLK,EEM,HYG
AGENT_LOOP_INTERVAL_SECONDS=300
AGENT_SCAN_TIMEBOX_SECONDS=150

# --- Exit tuning ----------------------------------------------------------- #
AGENT_PROFIT_TARGET_FRACTION=0.35
AGENT_TRAIL_ARM_FRACTION=0.25
AGENT_TRAIL_GIVEBACK_FRACTION=0.10
AGENT_STOP_LOSS_MULTIPLE=2.0
AGENT_DEBIT_STOP_FRACTION=0.50

# --- Operator controls ------------------------------------------------------ #
# Flatten the book at this ET wall-clock time and refuse all further trades.
# AGENT_HARD_STOP_ET=2026-09-04 10:30
# Drop a file at this path to keep managing open positions but open nothing new.
AGENT_HALT_FILE=HALT

# --- Optional -------------------------------------------------------------- #
# AGENT_DISCORD_WEBHOOK=          # alerts on fill / close / halt / hard stop
# AGENT_MCP=true                  # serve account + news reads via Alpaca's MCP server
# AGENT_MCP_SERVER_DIR=../alpaca-mcp-server
